# Local LiveKit (docker compose service "livekit")
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Must match agent/src/agent.py default
AGENT_NAME=v2v-poc-agent

# --- Reply mode (dual-mode demos) ---
# standard = Speaches STT → chat LLM → Kokoro TTS
# voice_to_voice = OpenAI/Azure Realtime speech path (needs Realtime credentials)
REPLY_MODE=standard

# End-of-utterance pause tolerance (milliseconds)
MIN_ENDPOINTING_DELAY_MS=500
MAX_ENDPOINTING_DELAY_MS=3000

# Session traces → Jaeger (docker compose) via OTLP HTTP + local JSONL + UI topic
TRACE_ENABLED=true
TRACE_DIR=traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
JAEGER_UI_URL=http://localhost:16686

# --- LLM: pick ONE mode ---

# A) Public OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# REALTIME_MODEL=gpt-realtime

# B) Azure OpenAI / PowerProxy (api-key header + deployments URL)
# Example working chat URL shape:
#   https://<host>/openai/deployments/<deployment>/chat/completions?api-version=<version>
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://powerproxy.dev.oneai.yo-digital.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
OPENAI_MODEL=gpt-5.4
OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=replace-with-your-api-key
# (OPENAI_API_KEY is also accepted as the api-key value)
# Required for voice_to_voice on Azure (chat deployments often are not Realtime-capable):
# REALTIME_AZURE_DEPLOYMENT=gpt-realtime
# Use a Realtime-capable api-version (do NOT reuse chat-only versions like 2024-10-21):
# REALTIME_API_VERSION=2024-10-01-preview
# Note: PowerProxy and many chat gateways return 403 on Realtime WebSockets; the agent
# probes the WS and auto-falls back to standard mode with a visible warning when blocked.

# Local speech via Speaches (docker compose)
SPEACHES_BASE_URL=http://localhost:8000/v1
WHISPER_MODEL=Systran/faster-whisper-small
KOKORO_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# Default TTS voice when the UI does not send persona metadata.
# Normal UI flow: avatar gender + language map to a Kokoro voice (e.g. af_heart / am_adam).
# Leave as a fallback only; UI metadata wins for the session when present.
KOKORO_VOICE=af_heart

# UI / agent join wait (seconds) before failing the session
AGENT_JOIN_TIMEOUT_SEC=30
