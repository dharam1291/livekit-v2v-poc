# Local LiveKit server (docker compose)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# Must match AGENT_NAME in agent/src/agent.py
AGENT_NAME=v2v-poc-agent

# Leave empty for local /api/token (recommended for this POC).
# Do NOT set to blank quotes if unused — omit the variable entirely.
# NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=
SANDBOX_ID=
